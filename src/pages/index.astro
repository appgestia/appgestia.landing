---
import { Image } from 'astro:assets';
import '../styles/landing.css';
import '../styles/sitio.css';
import panel from '../assets/panel.png';
import ventas from '../assets/ventas.png';
import mVentas from '../assets/m-ventas.png';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const URL_SITIO = 'https://appgestia.github.io/appgestia.landing/';
const APP = 'https://appgestia.github.io/';
// shortcut: número de ejemplo, reemplazar por el WhatsApp real antes de publicar
const CONTACTO = 'https://wa.me/5490000000000';
const titulo = 'Gestia · Software a medida para tu negocio';
const desc = 'Sistemas de gestión, páginas web, tiendas online, apps y automatizaciones para pymes y comercios. Te ayudamos de la idea a la entrega.';

// íconos con el mismo trazo que la app
const I = {
  gestion: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4M7 13l3-3 2 2 5-5"/>',
  web: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/>',
  tienda: '<path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  celu: '<rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M11 18h2"/>',
  rayo: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  reportes: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  flecha: '<path d="M5 12h14M13 6l6 6-6 6"/>',
};
const svg = (d: string) => `<svg viewBox="0 0 24 24" aria-hidden="true">${d}</svg>`;

const soluciones = [
  ['gestion', 'Sistemas de gestión', 'Stock, ventas, clientes, turnos o lo que tu negocio necesite controlar, en un sistema hecho a tu medida.'],
  ['web', 'Páginas web', 'Sitios rápidos y prolijos que explican lo que hacés y te traen consultas. Se ven bien en el celular.'],
  ['tienda', 'Tiendas online', 'Catálogo con precios y pedidos por WhatsApp o con pago online, conectado a tu stock.'],
  ['celu', 'Apps para celular', 'Apps que tus clientes o tu equipo instalan en el teléfono y funcionan aunque no haya señal.'],
  ['rayo', 'Automatizaciones', 'Lo que hoy hacés a mano en Excel o WhatsApp, resuelto solo: avisos, listas de precios, recordatorios.'],
  ['reportes', 'Reportes e integraciones', 'Juntamos los datos que tenés repartidos y los convertimos en números claros para decidir.'],
];

const pasos = [
  ['1', 'Charlamos', 'Nos contás cómo trabajás hoy y qué te gustaría resolver. Sin tecnicismos.'],
  ['2', 'Propuesta', 'Te mostramos qué vamos a hacer, en cuánto tiempo y cuánto sale, antes de empezar.'],
  ['3', 'Desarrollo', 'Vas viendo avances reales cada semana y los podés probar desde tu celular.'],
  ['4', 'Entrega y soporte', 'Lo dejamos andando, te enseñamos a usarlo y seguimos cerca para lo que haga falta.'],
];

const rubros = ['Comercios', 'Consultorios', 'Gastronomía', 'Distribuidoras', 'Estudios profesionales', 'Educación', 'Servicios', 'Talleres'];

const preguntas = [
  ['¿Cuánto cuesta un proyecto?', 'Depende de lo que necesites. Después de la primera charla te pasamos un presupuesto cerrado, sin sorpresas.'],
  ['¿Cuánto tarda?', 'Una página web puede estar en una o dos semanas. Un sistema a medida, entre uno y tres meses, con avances que vas probando en el camino.'],
  ['¿Tengo que saber de tecnología?', 'No. Nos encargamos de todo lo técnico y te explicamos cada paso en palabras simples.'],
  ['¿Qué pasa después de la entrega?', 'Seguimos dando soporte: corregimos lo que haga falta y sumamos mejoras cuando tu negocio crece.'],
];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{titulo}</title>
  <meta name="description" content={desc}>
  <meta name="theme-color" content="#0B2E33">
  <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml">
  <link rel="canonical" href={URL_SITIO}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={titulo}>
  <meta property="og:description" content={desc}>
  <meta property="og:url" content={URL_SITIO}>
  <meta property="og:locale" content="es_AR">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <header class="nav">
    <div class="wrap navin">
      <a class="marca" href={BASE} aria-label="Gestia, inicio"><img src={`${BASE}favicon.svg`} alt="" width="32" height="32"><b>gestia</b></a>
      <nav aria-label="Secciones">
        <a href="#soluciones">Soluciones</a>
        <a href="#productos">Productos</a>
        <a href="#como">Cómo trabajamos</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
      <a class="btn pri sm" href={CONTACTO}>Hablemos</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap heroc">
        <p class="eyebrow">Software a medida para pymes</p>
        <h1>Software que hace <span>crecer</span> tu negocio.</h1>
        <p class="lead">Sistemas de gestión, páginas web, tiendas online y automatizaciones. Te acompañamos de la idea a la entrega, sin vueltas.</p>
        <div class="ctas">
          <a class="btn pri lg" href={CONTACTO}>Contanos tu idea <Fragment set:html={svg(I.flecha)} /></a>
          <a class="btn ghost lg" href="#soluciones">Ver soluciones</a>
        </div>
        <div class="herovis vis-centro">
          <div class="pc"><div class="pcbar"><i></i><i></i><i></i></div><Image src={panel} alt="Gestia, uno de nuestros sistemas, en la compu" widths={[720, 1280, 1920]} sizes="(max-width: 980px) 92vw, 960px" loading="eager" /></div>
          <div class="cel"><Image src={mVentas} alt="Gestia en el celular" widths={[260, 390]} sizes="200px" loading="eager" /></div>
        </div>
      </div>
    </section>

    <section class="rubros" aria-label="Rubros">
      <div class="wrap">
        <p>Trabajamos con</p>
        <ul>{rubros.map(r => <li>{r}</li>)}</ul>
      </div>
    </section>

    <section class="sec" id="soluciones">
      <div class="wrap">
        <div class="tit">
          <p class="eyebrow">Soluciones</p>
          <h2>Para cada parte de tu negocio</h2>
          <p>Elegí por dónde empezar. Todo se puede combinar y crecer con vos.</p>
        </div>
        <div class="fgrid">
          {soluciones.map(([ic, t, d]) => (
            <article class="fcard rv">
              <div class="fic"><Fragment set:html={svg(I[ic as keyof typeof I])} /></div>
              <h3>{t}</h3>
              <p>{d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="sec alt" id="productos">
      <div class="wrap show">
        <div class="showtxt">
          <p class="eyebrow">Producto propio</p>
          <h2>Gestia para comercios.</h2>
          <ul class="lista">
            <li><Fragment set:html={svg(I.check)} />Ventas, stock y fiado en un solo lugar</li>
            <li><Fragment set:html={svg(I.check)} />Funciona en la compu o el celular, sin instalar nada</li>
            <li><Fragment set:html={svg(I.check)} />Sigue andando aunque se corte internet</li>
          </ul>
          <div class="ctas">
            <a class="btn pri" href={`${BASE}gestia/`}>Conocé Gestia <Fragment set:html={svg(I.flecha)} /></a>
            <a class="btn sec-link" href={APP}>Probala gratis</a>
          </div>
        </div>
        <div class="shot"><Image src={ventas} alt="Pantalla de ventas de Gestia con productos y el detalle de la venta" widths={[720, 1280, 1920]} sizes="(max-width: 980px) 92vw, 640px" /></div>
      </div>
    </section>

    <section class="sec" id="como">
      <div class="wrap">
        <div class="tit">
          <p class="eyebrow">Cómo trabajamos</p>
          <h2>Simple, claro y con avances que podés ver</h2>
        </div>
        <div class="vgrid">
          {pasos.map(([n, t, d]) => (
            <div class="vcard rv">
              <div class="fic num">{n}</div>
              <h3>{t}</h3>
              <p>{d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec faq-sec" id="preguntas">
      <div class="wrap faq">
        <div class="tit"><p class="eyebrow">Preguntas</p><h2>Lo que más nos consultan</h2></div>
        <div class="faqs">
          {preguntas.map(([p, r]) => (
            <details><summary>{p}</summary><p>{r}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section class="sec precio" id="contacto">
      <div class="wrap">
        <div class="pcard">
          <div>
            <p class="eyebrow">Contacto</p>
            <h2>¿Tenés una idea? Hablemos.</h2>
            <p>Contanos qué necesitás y te respondemos en el día.</p>
          </div>
          <a class="btn mint lg" href={CONTACTO}>Escribinos por WhatsApp <Fragment set:html={svg(I.flecha)} /></a>
        </div>
      </div>
    </section>
  </main>

  <footer class="pie">
    <div class="wrap piein">
      <a class="marca" href={BASE}><img src={`${BASE}favicon.svg`} alt="" width="28" height="28"><b>gestia</b></a>
      <p>Software a medida para pymes y comercios.</p>
      <a href={`${BASE}gestia/`}>Gestia para comercios</a>
    </div>
  </footer>

  <script>
    // aparición suave al bajar; sin animación si el sistema pide reducir movimiento
    const els = document.querySelectorAll('.rv');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      els.forEach(e => e.classList.add('in'));
    } else {
      const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      els.forEach(e => io.observe(e));
    }
  </script>
</body>
</html>
